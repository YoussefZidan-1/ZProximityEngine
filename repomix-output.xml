@import "tailwindcss";

@theme {
  --font-sans: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
  --font-serif: "Source Serif 4", serif;
}

@layer base {
  :root {
    --bg-color: #ffffff;
    --text-color: #0c0c0c;
    --border-color: #0c0c0c;
    --grid-dot: #d1d5db; /* Darkened dots for visibility */
  }

  .dark {
    --bg-color: #000000;
    --text-color: #f8fafc;
    --border-color: #f8fafc;
    --grid-dot: #1f2937;
  }

  body {
    @apply antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black;
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  * {
    @apply border-[var(--border-color)];
    transition-property: background-color, border-color, color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  .prox-part {
    transition: none !important;
  }
}

.mono-grid {
  background-image: radial-gradient(circle at 1px 1px, var(--grid-dot) 0.5px, transparent 0);
  background-size: 24px 24px;
}

@layer utilities {
  .smooth-strike {
    position: relative;
    display: inline-block;
  }
  .smooth-strike::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--text-color);
    transition: width 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .smooth-strike:hover::after {
    width: 100%;
  }

  .smooth-underline {
    position: relative;
    display: inline-block;
  }
  .smooth-underline::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--text-color);
    transition: width 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .smooth-underline:hover::after {
    width: 100%;
  }
}
</file>


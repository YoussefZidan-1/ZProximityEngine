// ─────────────────────────────────────────────────────────────────────────────
// CODE BLOCK with copy
// ─────────────────────────────────────────────────────────────────────────────

const CodeBlock = ({ code, label }: { code: string; label?: string }) => {
  const [copied, setCopied] = useState(false);

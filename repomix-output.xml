      <div className="w-2 h-2 rounded-full bg-yellow-400/30"></div>
      <div className="w-2 h-2 rounded-full bg-green-400/30"></div>
    </div>
    <pre className="whitespace-pre-wrap">
      <code>{code}</code>
    </pre>
  </div>
);


  background-size: 24px 24px;
}

@layer utilities {
  .smooth-strike {
    position: relative;
    display: inline-block;
  }
  .smooth-strike::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--text-color);
    transition: width 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .smooth-strike:hover::after {
    width: 100%;
  }

  .smooth-underline {
    position: relative;
    display: inline-block;
  }
  .smooth-underline::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: var(--text-color);
    transition: width 0.5s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .smooth-underline:hover::after {
    width: 100%;
  }
}

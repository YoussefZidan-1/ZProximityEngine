  }

  body {
    @apply antialiased selection:bg-black selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-700 ease-in-out;
    background-color: var(--bg-color);
    color: var(--text-color);
  }

  * {
    @apply border-[var(--border-color)] transition-colors duration-700 ease-in-out;
  }
}

.mono-grid {

const useClientPlugin = () => ({
  name: "add-use-client-directive",
  renderChunk(code: string, chunk: any) {
    if (chunk.fileName.endsWith(".es.js") && !code.includes("use client")) {
      return '"use client";\n' + code;
    }
    return null;
  },
});

export default defineConfig(({ mode }) => {

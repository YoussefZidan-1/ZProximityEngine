      <pre className="bg-black dark:bg-zinc-950 text-gray-300 p-5 pt-4 text-[11px] md:text-xs font-mono overflow-x-auto leading-relaxed shadow-lg w-full border border-black/20 dark:border-white/10">
        <code>{code}</code>

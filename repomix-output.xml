              else nd = itemProgress < focusPoint ? itemProgress / focusPoint : (1 - itemProgress) / (1 - focusPoint);
            }
          }

          const falloff = Math.max(0.01, config.activeFalloff);
          const expDenominator = 1 - Math.exp(-falloff);

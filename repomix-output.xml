    scope: containerRef
  });

  return (
    <div ref={containerRef} className={className} style={{ position: 'relative', touchAction: activeMode === 'scroll' ? 'auto' : 'pan-y', ...style }} {...restProps}>
      {children}
    </div>
  );
};

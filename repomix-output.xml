  { id: 'common-mistakes',  icon: '⚠️',  title: 'Common Mistakes' },
  { id: 'text-magic',       icon: '✍️',  title: 'Text Magic' },
  { id: 'neighbor-nearest', icon: '🎯', title: 'Neighbor vs Nearest' },
  { id: 'scroll-mode',      icon: '📜', title: 'Scroll Mode' },

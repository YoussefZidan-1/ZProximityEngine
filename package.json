{
  "name": "z-proximity-engine",
  "version": "2.5.5",
  "sideEffects": false,
  "description": "ِA high-performance proximity-based motion engine by Youssef Zidan for organic proximity-based UI.",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "animation",
    "proximity",
    "gsap",
    "motion",
    "hover-effects",
    "magnetic-cursor",
    "scroll-animations",
    "interaction-design",
    "ui-animations",
    "cursor-effects",
    "spatial-interactions",
    "react-animations",
    "gsap-react",
    "animation-library",
    "motion-design",
    "proximity-detection",
    "interactive-ui",
    "react-motion",
    "animation-framework",
    "typescript",
    "performance",
    "framer-motion-alternative"
  ],
  "author": "Youssef Zidan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoussefZidan-1/ZProximityEngine"
  },
  "bugs": {
    "url": "https://github.com/YoussefZidan-1/ZProximityEngine/issues"
  },
  "homepage": "https://z-proximity-engine.vercel.app/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "prepublishOnly": "npm run build:lib",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "size-limit": [
    {
      "path": "dist/index.es.js",
      "limit": "15 kB"
    }
  ],
  "peerDependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "size-limit": "^12.1.0",
    "split-type": "^0.3.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-sitemap": "^0.8.2",
    "dompurify": "^3.4.3"
  },
  "dependencies": {}
}

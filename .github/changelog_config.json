{
  "categories": [
    {
      "title": "## 🚀 New Features",
      "labels": ["feat", "feature"],
      "patterns": ["feat:.*", "feat\\(.*", "feature:.*"]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": ["fix", "bug"],
      "patterns": ["fix:.*", "fix\\(.*", "bug:.*"]
    },
    {
      "title": "## ⚡ Performance",
      "labels": ["perf", "optimization"],
      "patterns": ["perf:.*", "optimization:.*"]
    },
    {
      "title": "## 🔧 Maintenance",
      "labels": ["chore", "refactor"],
      "patterns": ["chore:.*", "refactor:.*", "style:.*"]
    }
  ],
  "ignore_labels": ["ignore", "skip-chane-log"],
  "template": "${{CHANGELOG}}",
  "pr_template": "- ${{TITLE}}",
  "empty_template": "## 🚀 What's Changed\n- Minor updates and performance improvements.",
  "tag_resolver": {
    "method": "semver"
  },
  "base_branches": ["main", "master"]
}